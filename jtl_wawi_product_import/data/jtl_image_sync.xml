<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="jtl_image_sync_config" model="jtl.image.sync">
            <field name="name">JTL Shop Image Sync</field>
            <field name="sitemap_url">https://www.schaltauge.com/export/sitemap_index.xml</field>
            <field name="batch_size">300</field>
        </record>

        <record id="ir_cron_jtl_image_sync" model="ir.cron">
            <field name="name">JTL: Produktbilder aus Shop-Sitemap synchronisieren</field>
            <field name="model_id" ref="model_jtl_image_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_images()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
