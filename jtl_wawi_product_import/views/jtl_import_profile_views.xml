<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jtl_import_profile_tree" model="ir.ui.view">
        <field name="name">jtl.import.profile.tree</field>
        <field name="model">jtl.import.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_default"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_jtl_import_profile_form" model="ir.ui.view">
        <field name="name">jtl.import.profile.form</field>
        <field name="model">jtl.import.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_duplicate_profile" type="object" string="Duplizieren" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="is_default"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Import-Einstellungen">
                            <field name="batch_size"/>
                            <field name="category_root_id" options="{'no_create': True}"/>
                            <field name="category_import_mode"/>
                            <field name="update_existing_only"/>
                            <field name="barcode_match_update"/>
                            <field name="manufacturer_create_brand"/>
                            <field name="import_stock"/>
                            <field name="import_images"/>
                            <field name="import_gallery_images"/>
                            <field name="import_seo"/>
                            <field name="dry_run"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="source_file_key"/>
                            <field name="source_column"/>
                            <field name="source_column_label"/>
                            <field name="sample_value"/>
                            <field name="target_model"/>
                            <field name="target_field"/>
                            <field name="create_field"/>
                            <field name="new_field_name"/>
                            <field name="new_field_label"/>
                            <field name="new_field_type"/>
                            <field name="relation_model"/>
                            <field name="language_id" options="{'no_create': True}"/>
                            <field name="transform_logic"/>
                            <field name="required"/>
                            <field name="import_enabled"/>
                            <field name="default_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jtl_import_profile" model="ir.actions.act_window">
        <field name="name">Mapping Profiles</field>
        <field name="res_model">jtl.import.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
