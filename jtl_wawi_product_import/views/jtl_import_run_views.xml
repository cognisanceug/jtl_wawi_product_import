<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jtl_import_log_tree" model="ir.ui.view">
        <field name="name">jtl.import.log.tree</field>
        <field name="model">jtl.import.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="level"/>
                <field name="batch_number"/>
                <field name="row_number"/>
                <field name="article_number"/>
                <field name="field_name"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_jtl_import_run_tree" model="ir.ui.view">
        <field name="name">jtl.import.run.tree</field>
        <field name="model">jtl.import.run</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="filename"/>
                <field name="state"/>
                <field name="batch_size"/>
                <field name="current_index"/>
                <field name="total_products"/>
                <field name="created_products"/>
                <field name="updated_products"/>
                <field name="errors_count"/>
                <field name="warnings_count"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_jtl_import_run_form" model="ir.ui.view">
        <field name="name">jtl.import.run.form</field>
        <field name="model">jtl.import.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_queue" type="object" string="Queue" class="btn-primary" invisible="state not in ('validated','failed','done')"/>
                    <button name="action_process_next_batch" type="object" string="Process Next Batch" invisible="state not in ('queued','running')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset" invisible="state not in ('validated','failed','done')"/>
                    <button name="action_open_logs" type="object" string="Logs"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,queued,running,done,failed"/>
                </header>
                <sheet>
                    <div class="alert alert-success" role="alert" invisible="state != 'done'">
                        <field name="result_message" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                        <field name="last_error" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="filename" readonly="1"/>
                            <field name="company_id"/>
                            <field name="batch_size"/>
                            <field name="import_limit" readonly="1"/>
                            <field name="dry_run" readonly="1"/>
                            <field name="barcode_match_update" readonly="1"/>
                        </group>
                        <group>
                            <field name="import_stock" readonly="1"/>
                            <field name="import_images" readonly="1"/>
                            <field name="import_gallery_images" readonly="1"/>
                            <field name="import_seo" readonly="1"/>
                        </group>
                    </group>
                    <group string="Progress">
                        <group>
                            <field name="current_index" readonly="1"/>
                            <field name="total_products" readonly="1"/>
                            <field name="last_batch_number" readonly="1"/>
                            <field name="validation_message" readonly="1"/>
                        </group>
                        <group>
                            <field name="created_products" readonly="1"/>
                            <field name="updated_products" readonly="1"/>
                            <field name="created_suppliers" readonly="1"/>
                            <field name="updated_suppliers" readonly="1"/>
                            <field name="created_variants" readonly="1"/>
                            <field name="warnings_count" readonly="1"/>
                            <field name="errors_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="level"/>
                                    <field name="batch_number"/>
                                    <field name="row_number"/>
                                    <field name="article_number"/>
                                    <field name="field_name"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attachments">
                            <field name="source_attachment_id" readonly="1"/>
                            <field name="payload_attachment_id" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_jtl_import_run" model="ir.actions.act_window">
        <field name="name">Import Runs</field>
        <field name="res_model">jtl.import.run</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_jtl_import_log" model="ir.actions.act_window">
        <field name="name">Import Logs</field>
        <field name="res_model">jtl.import.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_jtl_import_root" name="JTL Import" sequence="10" action="action_jtl_import_run"/>
    <menuitem id="menu_jtl_import_runs" name="Import Runs" parent="menu_jtl_import_root" action="action_jtl_import_run" sequence="10"/>
    <menuitem id="menu_jtl_import_logs" name="Logs" parent="menu_jtl_import_root" action="action_jtl_import_log" sequence="20"/>
    <menuitem id="menu_jtl_import_mappings" name="Field Mappings" parent="menu_jtl_import_root" action="action_jtl_import_mapping" sequence="30"/>
    <menuitem id="menu_jtl_import_profiles" name="Mapping Profiles" parent="menu_jtl_import_root" action="action_jtl_import_profile" sequence="40"/>
</odoo>
