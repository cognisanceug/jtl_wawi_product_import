<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jtl_import_wizard_form" model="ir.ui.view">
        <field name="name">jtl.import.wizard.form</field>
        <field name="model">jtl.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import JTL CSV Bundle" class="o_jtl_import_wizard">
                <header>
                    <button name="action_previous_step" type="object" string="Back" class="btn-secondary" invisible="wizard_step == 'files'"/>
                    <button name="action_apply_profile" type="object" string="Apply Profile" class="btn-secondary" invisible="wizard_step != 'files' or not profile_id"/>
                    <button name="action_next_step" type="object" string="Next" class="btn-secondary" invisible="wizard_step == 'review'"/>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="wizard_step != 'review'"/>
                    <button name="action_validate_and_queue" type="object" string="Validate and Queue" class="btn-primary" invisible="wizard_step != 'review'"/>
                </header>
                <group invisible="wizard_step != 'files'">
                    <field name="wizard_step" widget="statusbar" statusbar_visible="files,mapping,review"/>
                </group>
                <group invisible="wizard_step != 'files'">
                    <field name="precheck_message" nolabel="1" readonly="1" widget="html"/>
                </group>
                <group invisible="wizard_step != 'files'">
                    <group>
                        <field name="profile_id"/>
                        <field name="batch_size"/>
                        <field name="dry_run"/>
                        <field name="update_existing_only"/>
                        <field name="barcode_match_update"/>
                        <field name="headers_loaded" readonly="1"/>
                        <field name="contacts_installed" readonly="1" invisible="1"/>
                        <field name="website_sale_installed" readonly="1" invisible="1"/>
                        <field name="product_variants_enabled" readonly="1" invisible="1"/>
                    </group>
                    <group>
                        <field name="import_stock"/>
                        <field name="import_images"/>
                        <field name="import_gallery_images"/>
                        <field name="import_seo"/>
                        <field name="save_profile"/>
                        <field name="profile_name" invisible="not save_profile"/>
                    </group>
                </group>
                <group string="CSV-Dateien" invisible="wizard_step != 'files'">
                    <group>
                        <field name="article_master_file_data" filename="article_master_file_name"/>
                        <field name="manufacturer_file_data" filename="manufacturer_file_name"/>
                        <field name="eu_representative_file_data" filename="eu_representative_file_name"/>
                        <field name="category_file_data" filename="category_file_name"/>
                        <field name="supplierinfo_file_data" filename="supplierinfo_file_name"/>
                        <field name="variation_combination_file_data" filename="variation_combination_file_name"/>
                    </group>
                    <group>
                        <field name="variation_definition_file_data" filename="variation_definition_file_name"/>
                        <field name="attribute_file_data" filename="attribute_file_name"/>
                        <field name="feature_file_data" filename="feature_file_name"/>
                        <field name="bom_file_data" filename="bom_file_name"/>
                    </group>
                </group>
                <notebook invisible="wizard_step == 'files'">
                    <page string="Artikelstammdaten">
                        <field name="article_master_mapping_line_ids" nolabel="1" class="o_jtl_mapping_lines" context="{'default_source_file_key': 'article_master'}">
                            <list editable="bottom" limit="1000">
                                <field name="sequence" optional="hide"/>
                                <field name="active"/>
                                <field name="source_column"/>
                                <field name="relation_hint" string="Erkannt als" readonly="1"/>
                                <field name="target_model"/>
                                <field name="target_field_id" string="Odoo-Feld" options="{'no_create': True}"/>
                                <field name="create_field_if_missing" string="Neues Feld"/>
                                <field name="target_field_name" string="Feldname"/>
                                <field name="custom_field_ttype" string="Feldtyp"/>
                                <field name="language_id" string="Sprache" options="{'no_create': True}"/>
                                <field name="transform_logic" string="Umwandlung"/>
                                <field name="required"/>
                                <field name="default_value"/>
                            </list>
                        </field>
                    </page>
                    <page string="Herstellerdaten">
                        <field name="manufacturer_mapping_line_ids" nolabel="1" class="o_jtl_mapping_lines" context="{'default_source_file_key': 'manufacturer'}">
                            <list editable="bottom" limit="1000">
                                <field name="sequence" optional="hide"/>
                                <field name="active"/>
                                <field name="source_column"/>
                                <field name="relation_hint" string="Erkannt als" readonly="1"/>
                                <field name="target_model"/>
                                <field name="target_field_id" string="Odoo-Feld" options="{'no_create': True}"/>
                                <field name="create_field_if_missing" string="Neues Feld"/>
                                <field name="target_field_name" string="Feldname"/>
                                <field name="custom_field_ttype" string="Feldtyp"/>
                                <field name="language_id" string="Sprache" options="{'no_create': True}"/>
                                <field name="transform_logic" string="Umwandlung"/>
                                <field name="required"/>
                                <field name="default_value"/>
                            </list>
                        </field>
                    </page>
                    <page string="EU-RP-Daten">
                        <field name="eu_representative_mapping_line_ids" nolabel="1" class="o_jtl_mapping_lines" context="{'default_source_file_key': 'eu_representative'}">
                            <list editable="bottom" limit="1000">
                                <field name="sequence" optional="hide"/>
                                <field name="active"/>
                                <field name="source_column"/>
                                <field name="relation_hint" string="Erkannt als" readonly="1"/>
