<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jtl_import_profile_tree" model="ir.ui.view">
        <field name="name">jtl.import.profile.tree</field>
        <field name="model">jtl.import.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_jtl_import_profile_form" model="ir.ui.view">
        <field name="name">jtl.import.profile.form</field>
        <field name="model">jtl.import.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="source_column"/>
                            <field name="target_model"/>
                            <field name="target_field"/>
                            <field name="language_code"/>
                            <field name="transform_logic"/>
                            <field name="required"/>
                            <field name="default_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jtl_import_profile" model="ir.actions.act_window">
        <field name="name">Mapping Profiles</field>
        <field name="res_model">jtl.import.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
